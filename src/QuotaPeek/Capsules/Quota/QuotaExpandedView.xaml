<UserControl x:Class="QuotaPeek.Capsules.Quota.QuotaExpandedView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
          <ItemsControl x:Name="Cards">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource Panel}" CornerRadius="13" Padding="14,13" Margin="0,0,0,9" AutomationProperties.AutomationId="{Binding AutomationId}">
                  <StackPanel>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Grid Margin="0,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="27" Height="27" CornerRadius="8" Background="#283643" Margin="0,0,8,0"><TextBlock Text="{Binding Initial}" Foreground="{Binding Accent}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" AutomationProperties.AutomationId="ProviderName"/><TextBlock Text="{Binding Scope}" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
                      <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="10" VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Services}"><ItemsControl.ItemTemplate><DataTemplate>
                      <Border BorderBrush="{StaticResource Line}" BorderThickness="{Binding SeparatorThickness}" Padding="{Binding Padding}" Margin="{Binding Margin}" AutomationProperties.AutomationId="{Binding AutomationId}">
                        <StackPanel>
                          <Grid Visibility="{Binding HeaderVisibility}" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Card.Name}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Card.StatusText}" Foreground="{Binding Card.StatusBrush}" FontSize="9" VerticalAlignment="Center"/>
                          </Grid>
                          <StackPanel Visibility="{Binding Card.MoneyVisibility}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Card.PrimaryValue}" FontSize="{Binding ValueFontSize}" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                              <TextBlock Grid.Column="1" Text="{Binding Card.PrimaryLabel}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="6,0,0,5"/>
                            </Grid>
                            <TextBlock Text="{Binding Card.SecondaryText}" Visibility="{Binding Card.SecondaryVisibility}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,2" TextWrapping="Wrap"/>
                          </StackPanel>
                          <ItemsControl ItemsSource="{Binding Card.Windows}"><ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                              <Grid Margin="0,0,0,7"><TextBlock Text="{Binding Name}" FontSize="11"/><TextBlock Text="{Binding Remaining}" Foreground="{Binding Accent}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12"/></Grid>
                              <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Foreground="{Binding Accent}"/>
                              <TextBlock Text="{Binding Reset}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/>
                            </StackPanel>
                          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                          <StackPanel Visibility="{Binding Card.TrendVisibility}" Margin="0,7,0,5"><Viewbox Stretch="Fill" Height="34"><Polyline Width="286" Height="36" Points="{Binding Card.Trend}" Stroke="{Binding Card.Accent}" StrokeThickness="1.7" StrokeLineJoin="Round"/></Viewbox><TextBlock Text="{Binding Card.TrendLabel}" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
                          <StackPanel Visibility="{Binding Card.ForecastVisibility}" Margin="0,5,0,7"><TextBlock Text="{Binding Card.Forecast}" Visibility="{Binding Card.ForecastTextVisibility}" Foreground="{Binding Card.Accent}" FontSize="10"/><TextBlock Text="{Binding Card.ResetCredits}" Visibility="{Binding Card.ResetsVisibility}" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel>
                          <TextBlock Text="{Binding Message}" Visibility="{Binding MessageVisibility}" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,7"/>
                          <Button Content="连接账户" Visibility="{Binding Card.SetupVisibility}" Background="#2D4453" Margin="0,0,0,8" Padding="8,7" HorizontalAlignment="Left" Click="Settings_Click" AutomationProperties.Name="连接账户"/>
                          <TextBlock Text="{Binding Card.Updated}" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        <TextBlock x:Name="EmptyText" Text="还没有启用的数据源，在设置中添加一个。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,10"/>
  </StackPanel>
</UserControl>
