<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PulseCapsule.ico</ApplicationIcon>
    <AssemblyName>PulseCapsule</AssemblyName>
    <RootNamespace>PulseCapsule</RootNamespace>
    <Version>0.2.0</Version>
    <!-- WPF owns startup/DPI; WinForms is used only for NotifyIcon and monitor bounds. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PulseCapsule.Core\PulseCapsule.Core.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\docs\images\logo.png" Link="Assets\logo.png" />
    <Resource Include="Assets\PulseCapsule.ico" />
  </ItemGroup>
</Project>
