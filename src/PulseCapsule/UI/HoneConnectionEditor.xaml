<UserControl x:Class="PulseCapsule.UI.HoneConnectionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="0,8,0,0">
    <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,8"/>
    <TextBlock x:Name="ServiceTitle" FontSize="14" FontWeight="SemiBold"/>
    <PasswordBox x:Name="SecretInput"/>
    <TextBlock x:Name="SecretHint" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
    <Expander x:Name="Advanced" Header="连接选项" Margin="0,6,0,0">
      <StackPanel Margin="0,10,0,0">
        <TextBlock Text="连接名称" Foreground="{StaticResource Muted}"/><TextBox x:Name="ConnectionName" MaxLength="32" AutomationProperties.Name="连接名称"/>
        <TextBlock Text="或从此环境变量读取" Foreground="{StaticResource Muted}"/><TextBox x:Name="SecretEnvironment" AutomationProperties.Name="密钥环境变量名称"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="刷新间隔 / 分钟" Foreground="{StaticResource Muted}"/><TextBox x:Name="RefreshMinutes" AutomationProperties.Name="刷新间隔（分钟）"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="剩余金额提醒" Foreground="{StaticResource Muted}"/><TextBox x:Name="LowThreshold" AutomationProperties.Name="剩余金额提醒"/></StackPanel>
        </Grid>
        <StackPanel x:Name="BillingOptions"><TextBlock Text="usage 换算倍数" Foreground="{StaticResource Muted}"/><TextBox x:Name="UsageMultiplier" AutomationProperties.Name="API key usage 换算倍数"/></StackPanel>
        <WrapPanel><Button Content="清除保存的密钥" Background="Transparent" Foreground="{StaticResource Danger}" Click="Clear_Click" Margin="0,0,8,0"/><Button Content="移除此连接" Background="Transparent" Foreground="{StaticResource Danger}" Click="Remove_Click"/></WrapPanel>
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
